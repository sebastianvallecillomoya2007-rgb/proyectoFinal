{
  "name": "proyecto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.js",
    "server": "node server/index.js",
    "test": "node --test server/*.test.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
